{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "antiprogram-ygo-card-searcher",
  "main": "./worker/index.mjs",
  "compatibility_date": "2026-08-23",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/card-images/*",
      "/chinese-card-images/*"
    ]
  }
}
