{
  "name": "ygo-card-searcher",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "npm run dev:worker",
    "dev:node": "node --watch-path=server server/index.mjs",
    "dev:client": "vite",
    "predev:worker": "npm run build",
    "dev:worker": "concurrently --kill-others --names worker,client \"wrangler dev --port 8787 --persist-to .wrangler/state\" \"vite --config vite.worker.config.ts\"",
    "db:migrate:local": "wrangler d1 migrations apply DB --local --persist-to .wrangler/state",
    "db:seed:local": "wrangler d1 execute DB --local --persist-to .wrangler/state --file seed/card-catalog.sql",
    "db:setup:local": "npm run db:migrate:local && npm run db:seed:local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "sync:local": "node scripts/trigger-local-sync.mjs",
    "build": "tsc && vite build",
    "preview": "node server/index.mjs --production",
    "preview:worker": "npm run build && wrangler dev --port 8787 --persist-to .wrangler/state",
    "start": "node server/index.mjs --production",
    "check:worker": "npm run build && wrangler deploy --dry-run",
    "deploy:cloudflare": "npm run build && wrangler deploy",
    "test": "node --test server/providers/parsers.test.mjs worker/index.test.mjs"
  },
  "dependencies": {
    "axios": "^1.6.7",
    "lucide-react": "^0.344.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^10.0.5",
    "typescript": "^5.2.2",
    "vite": "^5.1.6",
    "wrangler": "^4.125.0"
  }
}
