# Deck Plaza defaults to process-memory SWR cache.
# Set to sqlite to keep the last successful normalized snapshot across restarts.
DECK_PLAZA_STORAGE=memory
DECK_PLAZA_SQLITE_PATH=data/deck-plaza.sqlite

# Shared port for the Vite UI and API in development; production defaults to 4173.
HOST=127.0.0.1
PORT=3000
